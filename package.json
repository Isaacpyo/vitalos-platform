{
  "name": "vitalos-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Vitalos production platform monorepo",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "corepack pnpm --filter @vitalos/web dev",
    "storybook": "corepack pnpm --filter @vitalos/storybook dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test tests/end-to-end",
    "test:e2e:sparse": "node tests/support/run-sparse.mjs",
    "test:a11y": "playwright test tests/accessibility",
    "test:storybook-a11y": "playwright test -c tests/storybook/playwright.config.ts",
    "test:visual": "playwright test -c tests/visual/playwright.config.ts",
    "test:visual:update": "playwright test -c tests/visual/playwright.config.ts --update-snapshots",
    "test:perf": "playwright test tests/performance",
    "storybook:build": "corepack pnpm --filter @vitalos/storybook build",
    "db:test": "supabase test db",
    "relay:ingest": "corepack pnpm --filter @vitalos/relay-knowledge ingest",
    "relay:faq-sync": "corepack pnpm --filter @vitalos/relay-knowledge faq-sync",
    "relay:eval": "corepack pnpm --filter @vitalos/relay-knowledge eval",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:boundaries": "dependency-cruiser --config dependency-cruiser.cjs apps packages services workers",
    "check:email": "node tooling/scripts/check-email-senders.mjs",
    "check:raw-colours": "node tooling/scripts/check-raw-colours.mjs",
    "media:slots": "node tooling/scripts/media-slots.mjs && prettier --write docs/design/IMAGE-SLOTS.md",
    "media:product-snapshot": "node tooling/scripts/product-snapshot.mjs",
    "check:bundle-secrets": "node tooling/scripts/check-client-bundle-secrets.mjs",
    "check:turbo-env": "node tooling/scripts/check-turbo-env.mjs",
    "check:security": "node tooling/scripts/check-secrets.mjs && corepack pnpm audit --audit-level high",
    "content:types": "corepack pnpm --filter @vitalos/web exec node scripts/content-types.mjs",
    "content:export-repo": "corepack pnpm --filter @vitalos/web exec node --import ./scripts/ts-resolve.mjs scripts/export-repo-content.mjs",
    "content:types:check": "corepack pnpm --filter @vitalos/web exec node scripts/content-types.mjs --check",
    "check": "corepack pnpm format:check && corepack pnpm check:raw-colours && corepack pnpm check:turbo-env && corepack pnpm content:types:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm check:boundaries",
    "relay:load": "corepack pnpm --filter @vitalos/relay-knowledge load",
    "seo:crawl": "node --no-warnings tooling/seo/crawl-cli.mjs",
    "seo:lighthouse": "node --no-warnings tooling/seo/lighthouse.mjs",
    "seo:check": "node --no-warnings tooling/seo/seo-check.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@vitalos/eslint-config": "workspace:*",
    "dependency-cruiser": "18.5.0",
    "lighthouse": "13.5.0",
    "parse5": "8.0.1",
    "prettier": "3.9.10",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
