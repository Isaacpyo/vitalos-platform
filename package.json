{
  "name": "vitalos-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Vitalos production platform monorepo",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "corepack pnpm --filter @vitalos/web dev",
    "dev:studio": "corepack pnpm --filter @vitalos/studio dev",
    "storybook": "corepack pnpm --filter @vitalos/storybook dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test tests/end-to-end",
    "test:a11y": "playwright test tests/accessibility",
    "storybook:build": "corepack pnpm --filter @vitalos/storybook build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:boundaries": "dependency-cruiser --config dependency-cruiser.cjs apps packages services workers",
    "check:security": "node tooling/scripts/check-secrets.mjs && corepack pnpm audit --audit-level high",
    "check": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm check:boundaries"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@vitalos/eslint-config": "workspace:*",
    "dependency-cruiser": "17.1.0",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "5.9.2",
    "vitest": "3.2.6"
  }
}
