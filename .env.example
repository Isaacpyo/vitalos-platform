# Vitalos environment contract. Validated by packages/config (schema.ts).
# Copy to .env.local for development. Never commit real values.
# Empty values are treated as unset. Every variable is optional locally: the platform builds
# and runs with no Sanity or Supabase configuration (empty content source, enquiries disabled).

# ---------------------------------------------------------------------------
# Public (safe for browser bundles; NEXT_PUBLIC_* is inlined at build time)
# ---------------------------------------------------------------------------
# Canonical origin without a path. Required (and https) when VITALOS_DEPLOY_ENV is production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=development
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19
# Studio origin, used for Presentation / preview links.
NEXT_PUBLIC_SANITY_STUDIO_URL=
# Turnstile site key. Must be set together with TURNSTILE_SECRET_KEY.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# Deployment mode
# ---------------------------------------------------------------------------
# In production (VITALOS_DEPLOY_ENV=production or VERCEL_ENV=production) these must be set
# explicitly: NEXT_PUBLIC_SITE_URL (https origin), VITALOS_CONTENT_SOURCE,
# VITALOS_ENQUIRY_BACKEND, and NEXT_PUBLIC_SANITY_DATASET when the source is sanity.
# NODE_ENV is not used to detect production (next build always sets it).
# local | preview | staging | production. When unset it is derived from VERCEL_ENV
# (production -> production, preview -> preview, anything else -> local).
# Everything except production is served with X-Robots-Tag: noindex, nofollow.
VITALOS_DEPLOY_ENV=
# sanity | empty | fixtures | draft. Default: sanity when NEXT_PUBLIC_SANITY_PROJECT_ID is set,
# else empty. fixtures (artificial content for tests) and draft (repo-authored content pending
# owner approval, ADR-025) are rejected in production; draft cannot use the supabase backend.
VITALOS_CONTENT_SOURCE=
# full | sparse. Only used with VITALOS_CONTENT_SOURCE=fixtures.
VITALOS_FIXTURE_SET=
# supabase | memory | disabled. Default: supabase when SUPABASE_URL and SUPABASE_SECRET_KEY are
# set, else disabled. memory (tests only) is rejected in production.
VITALOS_ENQUIRY_BACKEND=

# ---------------------------------------------------------------------------
# Server-only. Never prefix secrets with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
# Sanity
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=
# Studio origin allowed to frame the site outside production (CSP frame-ancestors).
SANITY_STUDIO_ORIGIN=

# Sanity Studio (apps/studio). SANITY_STUDIO_* values are bundled into the Studio, so they must
# never hold secrets. All optional: with no project id the Studio falls back to a placeholder so
# `sanity build` and `sanity schema extract` (SANITY_SCHEMA_EXTRACT=1) work in CI without credentials.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=development
# Origin of the web app the Presentation tool previews (draft mode via /api/draft-mode/enable).
# Defaults to http://localhost:3000.
SANITY_STUDIO_PREVIEW_URL=

# Supabase (service-role style secret key; server-side only)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Turnstile
TURNSTILE_SECRET_KEY=

# Email notifications. EMAIL_PROVIDER: none | console | postmark | resend. Console is rejected in
# production; none is rejected in production once ENQUIRY_NOTIFICATION_TO is set. postmark and resend
# require EMAIL_FROM, EMAIL_PROVIDER_API_KEY (server-only) and ENQUIRY_NOTIFICATION_TO.
EMAIL_PROVIDER=none
EMAIL_PROVIDER_API_KEY=
# Recommended provider: Resend. Intended values once the provider and DNS are approved:
#   EMAIL_FROM=Vitalos <support@vitalos.co.uk>
#   ENQUIRY_NOTIFICATION_TO=support@vitalos.co.uk
EMAIL_FROM=
ENQUIRY_NOTIFICATION_TO=

# Enquiry pipeline secrets (generate long random values; 16+ and 32+ characters respectively)
ENQUIRY_IP_HASH_SALT=
# Current privacy notice version (1-40 of A-Z a-z 0-9 . _ -). A submission must present exactly
# this value; it is stored with each enquiry as the consent record. Required in production with
# the supabase backend. The value is an owner decision (it tracks the published privacy notice).
ENQUIRY_PRIVACY_NOTICE_VERSION=
OUTBOX_DISPATCH_SECRET=
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to /api/internal/outbox/dispatch (32+
# characters). Set it in the Vercel project; the dispatch route accepts it or OUTBOX_DISPATCH_SECRET.
CRON_SECRET=

# Send Strict-Transport-Security. Owner decision; leave false until approved.
ENABLE_HSTS=false
