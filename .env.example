# Vitalos environment contract. Validated by packages/config (schema.ts).
# Copy to .env.local for development. Never commit real values.
# Empty values are treated as unset. Every variable is optional locally: the platform builds
# and runs with no Supabase configuration (repo content, enquiries disabled).

# ---------------------------------------------------------------------------
# Public (safe for browser bundles; NEXT_PUBLIC_* is inlined at build time)
# ---------------------------------------------------------------------------
# Canonical origin without a path. Required (and https) when VITALOS_DEPLOY_ENV is production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Turnstile site key. Must be set together with TURNSTILE_SECRET_KEY.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Image slot labels (docs/design/IMAGE-SLOTS.md): 1 shows, 0 hides. Unset: shown in development and
# on Vercel previews, never in production.
NEXT_PUBLIC_MEDIA_LABELS=

# ---------------------------------------------------------------------------
# Deployment mode
# ---------------------------------------------------------------------------
# In production (VITALOS_DEPLOY_ENV=production or VERCEL_ENV=production) these must be set
# explicitly: NEXT_PUBLIC_SITE_URL (https origin), VITALOS_CONTENT_SOURCE (repo),
# VITALOS_ENQUIRY_BACKEND.
# NODE_ENV is not used to detect production (next build always sets it).
# local | preview | staging | production. When unset it is derived from VERCEL_ENV
# (production -> production, preview -> preview, anything else -> local).
# Everything except production is served with X-Robots-Tag: noindex, nofollow.
VITALOS_DEPLOY_ENV=
# repo | draft | fixtures | empty. Default: repo (approved repo-file content, ADR-028;
# allowed in production). fixtures (artificial content for tests) and draft (repo-authored content
# pending owner approval, ADR-025) are rejected in production; draft cannot use the supabase
# backend.
VITALOS_CONTENT_SOURCE=
# full | sparse. Only used with VITALOS_CONTENT_SOURCE=fixtures.
VITALOS_FIXTURE_SET=
# supabase | memory | disabled. Default: supabase when SUPABASE_URL and SUPABASE_SECRET_KEY are
# set, else disabled. memory (tests only) is rejected in production.
VITALOS_ENQUIRY_BACKEND=

# ---------------------------------------------------------------------------
# Server-only. Never prefix secrets with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
# Supabase (service-role style secret key; server-side only)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Turnstile
TURNSTILE_SECRET_KEY=

# Email notifications. EMAIL_PROVIDER: none | console | postmark | resend. Console is rejected in
# production; none is rejected in production once ENQUIRY_NOTIFICATION_TO is set. postmark and resend
# require EMAIL_FROM, EMAIL_PROVIDER_API_KEY (server-only) and ENQUIRY_NOTIFICATION_TO.
EMAIL_PROVIDER=none
EMAIL_PROVIDER_API_KEY=
# With EMAIL_PROVIDER=resend, RESEND_API_KEY (server-only) is accepted as a fallback; EMAIL_PROVIDER_API_KEY wins if both are set.
# RESEND_API_KEY=
# Recommended provider: Resend. Intended values once the provider and DNS are approved:
#   EMAIL_FROM=Vitalos <support@vitalos.co.uk>
#   ENQUIRY_NOTIFICATION_TO=support@vitalos.co.uk
EMAIL_FROM=
ENQUIRY_NOTIFICATION_TO=

# Enquiry pipeline secrets (generate long random values; 16+ and 32+ characters respectively)
ENQUIRY_IP_HASH_SALT=
# Current privacy notice version (1-40 of A-Z a-z 0-9 . _ -). A submission must present exactly
# this value; it is stored with each enquiry as the consent record. Required in production with
# the supabase backend. The value is an owner decision (it tracks the published privacy notice).
ENQUIRY_PRIVACY_NOTICE_VERSION=
OUTBOX_DISPATCH_SECRET=
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to /api/internal/outbox/dispatch and
# /api/internal/retention/purge (32+
# characters). Set it in the Vercel project; the dispatch route accepts it or OUTBOX_DISPATCH_SECRET.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Insights and Careers content API on the Super Admin (ADR-039, ADR-040). Server-only.
# Leave CONTENT_API_BASE_URL empty and both sections behave as closed (index 404, no homepage
# sections) and nothing calls the admin. Key ids match [a-z0-9-]{1,32}; secrets are 32+ characters.
# ---------------------------------------------------------------------------
# Admin origin, e.g. https://admin.vitalos.co.uk (https in production). Needs the read key.
CONTENT_API_BASE_URL=
# Signs read-API and tick calls to the admin (scope read/tick).
CONTENT_READ_KEY_ID=
CONTENT_READ_SECRET=
# Signs upload-ticket and application calls to the admin (scope submit).
CAREERS_SUBMIT_KEY_ID=
CAREERS_SUBMIT_SECRET=
# Verify the admin's calls to the website: keyId:secret[,keyId:secret]. Any listed key is
# accepted, so keys rotate with no downtime. Unset: the matching route answers 503.
CONTENT_REVALIDATE_SECRET=
CONTENT_RENDER_SECRET=
CONTENT_PREVIEW_SECRET=
# Revalidate interval of every cached content read, in seconds (30-86400). Default 600.
CONTENT_CACHE_TTL_SECONDS=
# Public media host for Insights and Careers images (next/image and CSP img-src), e.g.
# media.vitalos.co.uk or https://media.vitalos.co.uk.
CONTENT_MEDIA_HOST=
# CV upload host (object storage, or the admin for the fallback) for CSP connect-src.
CAREERS_UPLOAD_HOST=
# Turnstile (NEXT_PUBLIC_TURNSTILE_SITE_KEY, TURNSTILE_SECRET_KEY) and CRON_SECRET above are reused.

# Send Strict-Transport-Security. Owner decision; leave false until approved.
ENABLE_HSTS=false

# ---------------------------------------------------------------------------
# Vitalos Relay (docs/relay/README.md, ADR-035 to ADR-038). Off unless RELAY_ENABLED=true.
# Production with Relay on requires: RELAY_STORE=supabase, RELAY_LLM_PROVIDER=deepseek with
# DEEPSEEK_API_KEY, Turnstile keys, RELAY_ADMIN_API_SECRET and RELAY_SUPERADMIN_WEBHOOK_URL (https).
# ---------------------------------------------------------------------------
RELAY_ENABLED=false
# supabase | memory (memory: tests only, rejected in production when Relay is on)
RELAY_STORE=
# deepseek | mock (default: deepseek when DEEPSEEK_API_KEY is set, else mock)
RELAY_LLM_PROVIDER=
# Secret. Create at platform.deepseek.com as vitalos-relay-{env}; separate keys per environment.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-chat and deepseek-reasoner are retired and rejected.
RELAY_MODEL=deepseek-flash
RELAY_SUMMARY_MODEL=deepseek-flash
# Kill switch (Settings can also switch AI off).
RELAY_AI_ENABLED=true
RELAY_DAILY_TOKEN_CAP=2000000
RELAY_SIM_FLOOR=0.70
# Supabase publishable (anon) key for content-free realtime pings; the URL is SUPABASE_URL.
RELAY_REALTIME_PUBLIC_KEY=
# relay-embed Edge Function URL and its shared secret (also a Supabase function secret).
RELAY_EMBED_FUNCTION_URL=
RELAY_EMBED_SECRET=
# Secrets: 32+ random characters (pepper) and 16+ (salt).
RELAY_TOKEN_PEPPER=
RELAY_IP_SALT=
# Extra allowed origins (comma-separated). The site URL (and vitalos.co.uk in production) are always allowed.
RELAY_ALLOWED_ORIGINS=
# Signed server-to-server interfaces with the Super Admin (docs/relay/API.md). 32+ characters each.
RELAY_ADMIN_API_SECRET=
# Optional: the previous admin API secret, accepted during a rotation window.
RELAY_ADMIN_API_SECRET_PREVIOUS=
RELAY_WEBHOOK_SECRET=
RELAY_SUPERADMIN_WEBHOOK_URL=
RELAY_ADMIN_BASE_URL=
# Visitor reply emails: off; turning on in production needs owner approval.
RELAY_VISITOR_EMAILS_ENABLED=false
RELAY_EMAIL_FROM=
# Privacy notice version recorded with hand-off consent (defaults to ENQUIRY_PRIVACY_NOTICE_VERSION).
RELAY_PRIVACY_NOTICE_VERSION=
# Master FAQ (Notion). Token: read-only internal integration connected to the Master FAQ page only.
NOTION_FAQ_TOKEN=
NOTION_FAQ_DATA_SOURCE_ID=3fae4b34-11f9-80b0-9910-000b57eabfa1
NOTION_FAQ_DATABASE_ID=3fae4b34-11f9-808c-b450-c69d43e8f22c
NOTION_FAQ_HUB_PAGE_ID=3fae4b34-11f9-8053-9467-e390b032064a
NOTION_API_VERSION=
RELAY_FAQ_SYNC_ENABLED=true
# true in production (FAQ live only while the hub page Status is Active); false elsewhere by default.
RELAY_FAQ_REQUIRE_HUB_ACTIVE=
RELAY_FAQ_WRITEBACK_ENABLED=false
