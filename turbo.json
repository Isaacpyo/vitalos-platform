{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalEnv": [
    "CAREERS_SUBMIT_KEY_ID",
    "CAREERS_SUBMIT_SECRET",
    "CAREERS_UPLOAD_HOST",
    "CONTENT_API_BASE_URL",
    "CONTENT_CACHE_TTL_SECONDS",
    "CONTENT_MEDIA_HOST",
    "CONTENT_PREVIEW_SECRET",
    "CONTENT_READ_KEY_ID",
    "CONTENT_READ_SECRET",
    "CONTENT_RENDER_SECRET",
    "CONTENT_REVALIDATE_SECRET",
    "CRON_SECRET",
    "EMAIL_FROM",
    "EMAIL_PROVIDER",
    "EMAIL_PROVIDER_API_KEY",
    "ENABLE_HSTS",
    "ENQUIRY_IP_HASH_SALT",
    "ENQUIRY_NOTIFICATION_TO",
    "ENQUIRY_PRIVACY_NOTICE_VERSION",
    "NEXT_PUBLIC_MEDIA_LABELS",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY",
    "OUTBOX_DISPATCH_SECRET",
    "RESEND_API_KEY",
    "SUPABASE_SECRET_KEY",
    "SUPABASE_URL",
    "TURNSTILE_SECRET_KEY",
    "VERCEL_ENV",
    "VERCEL_URL",
    "VITALOS_CONTENT_SOURCE",
    "VITALOS_DEPLOY_ENV",
    "VITALOS_ENQUIRY_BACKEND",
    "VITALOS_FIXTURE_SET"
  ],
  "tasks": {
    "dev": { "cache": false, "persistent": true },
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "dist/**", "storybook-static/**"] },
    "lint": { "dependsOn": ["^lint"] },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "dependsOn": ["^build"], "outputs": ["coverage/**"] }
  }
}
