{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalEnv": [
    "CAREERS_SUBMIT_KEY_ID",
    "CAREERS_SUBMIT_SECRET",
    "CAREERS_UPLOAD_HOST",
    "CONTENT_API_BASE_URL",
    "CONTENT_CACHE_TTL_SECONDS",
    "CONTENT_TICK_SECRET",
    "CONTENT_MEDIA_HOST",
    "CONTENT_PREVIEW_SECRET",
    "CONTENT_READ_KEY_ID",
    "CONTENT_READ_SECRET",
    "CONTENT_RENDER_SECRET",
    "CONTENT_REVALIDATE_SECRET",
    "CRON_SECRET",
    "DEEPSEEK_API_KEY",
    "DEEPSEEK_BASE_URL",
    "EMAIL_FROM",
    "EMAIL_PROVIDER",
    "EMAIL_PROVIDER_API_KEY",
    "ENABLE_HSTS",
    "ENQUIRY_IP_HASH_SALT",
    "ENQUIRY_NOTIFICATION_TO",
    "ENQUIRY_PRIVACY_NOTICE_VERSION",
    "NEXT_PUBLIC_MEDIA_LABELS",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY",
    "NOTION_API_VERSION",
    "NOTION_FAQ_DATABASE_ID",
    "NOTION_FAQ_DATA_SOURCE_ID",
    "NOTION_FAQ_HUB_PAGE_ID",
    "NOTION_FAQ_TOKEN",
    "OUTBOX_DISPATCH_SECRET",
    "RELAY_ADMIN_API_SECRET",
    "RELAY_ADMIN_API_SECRET_PREVIOUS",
    "RELAY_ADMIN_BASE_URL",
    "RELAY_AI_ENABLED",
    "RELAY_ALLOWED_ORIGINS",
    "RELAY_DAILY_TOKEN_CAP",
    "RELAY_EMAIL_FROM",
    "RELAY_EMBED_FUNCTION_URL",
    "RELAY_EMBED_SECRET",
    "RELAY_ENABLED",
    "RELAY_FAQ_REQUIRE_HUB_ACTIVE",
    "RELAY_FAQ_SYNC_ENABLED",
    "RELAY_FAQ_WRITEBACK_ENABLED",
    "RELAY_IP_SALT",
    "RELAY_LLM_PROVIDER",
    "RELAY_MODEL",
    "RELAY_PRIVACY_NOTICE_VERSION",
    "RELAY_RATE_LIMIT_MULTIPLIER",
    "RELAY_REALTIME_PUBLIC_KEY",
    "RELAY_SIM_FLOOR",
    "RELAY_STORE",
    "RELAY_SUMMARY_MODEL",
    "RELAY_SUPERADMIN_WEBHOOK_URL",
    "RELAY_TOKEN_PEPPER",
    "RELAY_VISITOR_EMAILS_ENABLED",
    "RELAY_WEBHOOK_SECRET",
    "RESEND_API_KEY",
    "SUPABASE_SECRET_KEY",
    "SUPABASE_URL",
    "TURNSTILE_SECRET_KEY",
    "VERCEL_ENV",
    "VERCEL_URL",
    "VITALOS_CONTENT_SOURCE",
    "VITALOS_DEPLOY_ENV",
    "VITALOS_ENQUIRY_BACKEND",
    "VITALOS_FIXTURE_SET"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", "storybook-static/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
