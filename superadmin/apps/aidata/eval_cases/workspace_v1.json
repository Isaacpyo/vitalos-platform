{
  "dataset": "workspace-v1",
  "description": "Reliability cases for the AI & Data workspace prompts. Pasted texts and notes are synthetic. Model responses are hand-written test doubles (SimulatedProvider): they test the controls around the model, not model quality. No live recordings exist.",
  "cases": [
    {
      "id": "extract-incomplete-no-contact",
      "category": "incomplete",
      "prompt": "brief_extract",
      "text": "We want to automate something in our spreadsheets but we are not sure where to start.",
      "response": {
        "respond": {
          "fields": [],
          "offer": {
            "value": "",
            "reasons": []
          },
          "next_action": {
            "value": "",
            "reasons": []
          },
          "unclear": [
            "problem_summary"
          ]
        }
      },
      "expect": {
        "outcome": "success",
        "blank": [
          "contact_email",
          "contact_phone",
          "organisation",
          "contact_name"
        ],
        "missing_includes": [
          "contact_email"
        ],
        "next_action_startswith": "Find a contact route",
        "unclear_includes": [
          "problem_summary"
        ]
      }
    },
    {
