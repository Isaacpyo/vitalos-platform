# Vitalos Super Admin configuration. Copy to .env for local development (never commit .env).
# In production every value is set as a platform secret / environment variable instead.

# --- Django core -------------------------------------------------------------------------------
# Settings module: config.settings.dev (local), config.settings.test (pytest), config.settings.prod (live).
DJANGO_SETTINGS_MODULE=config.settings.dev
# Required in prod, at least 50 random characters. Generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
# Leave empty locally: dev generates one into the ignored .dev_secret_key file.
DJANGO_SECRET_KEY=
# Dev only: set to False to preview production error pages locally.
DJANGO_DEBUG=True
# Shown as a banner outside production (development, staging, production). The app keeps this name;
# there is no APP_ENV.
APP_ENVIRONMENT=development
# Public base URL, used in emailed links. Prod: https://admin.vitalos.co.uk (the deploy always sets it).
APP_BASE_URL=http://localhost:8000
# Comma-separated host names the app answers to. Prod: admin.vitalos.co.uk
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated scheme+host origins allowed to POST. Prod: https://admin.vitalos.co.uk
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Database ----------------------------------------------------------------------------------
# Defaults to SQLite (db.sqlite3) when unset. Prod: Supabase session pooler (or Neon pooled) string, e.g.
# postgresql://postgres.<project-ref>:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
# Seconds to keep database connections open between requests. Prod defaults to 0 (pooled free-tier database).
DB_CONN_MAX_AGE=60
# Disable server-side cursors (required behind transaction pooling, e.g. Neon's PgBouncer). Prod default True.
DB_DISABLE_SERVER_SIDE_CURSORS=False

# --- HTTPS and proxies (prod) ------------------------------------------------------------------
# Redirect plain HTTP to HTTPS (the ingress terminates TLS and sets X-Forwarded-Proto).
SECURE_SSL_REDIRECT=True
# Strict-Transport-Security max-age in seconds (1 year).
SECURE_HSTS_SECONDS=31536000
# Reverse-proxy hops trusted for X-Forwarded-For (client IP for lockouts). Azure Container Apps: 1.
TRUSTED_PROXY_COUNT=0

# --- Bootstrap administrator -------------------------------------------------------------------
# Used by `manage.py create_superadmin` (release job). The password is only ever read from here.
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
# At least 12 characters. Generate a strong value and keep it in the secrets store, never in git.
BOOTSTRAP_ADMIN_PASSWORD=

# --- Authentication hardening ------------------------------------------------------------------
# Require TOTP for SuperAdmin accounts (keep True outside throwaway local databases).
# REQUIRE_MFA_FOR_SUPER_ADMIN is accepted as an alias.
OTP_REQUIRED_FOR_SUPERADMIN=True
# The single primary owner. `manage.py create_owner` (run by the release job) creates this account with
# no password; `manage.py issue_setup_link --email <it>` prints a one-time 30-minute set-password link.
# Only the owner grants or revokes SuperAdmin. There is no SUPER_ADMIN_EMAILS list. Empty = no owner.
PRIMARY_OWNER_EMAIL=
# Pre-fill the sign-in email field. Empty (default) because pre-filling a public page reveals the login.
DEFAULT_SIGNIN_EMAIL=
# Offer "Forgot password". Leave empty for the default: on only when mail can be delivered.
PASSWORD_RESET_ENABLED=
# Failed sign-ins (per email + IP) before a temporary lockout, and the lockout length in minutes.
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=30

# --- Email: outbound, inbound and notifications (docs/email-setup.md) --------------------------
# Address enquiry replies are sent from and the inbound Worker is bound to.
SUPPORT_MAILBOX=support@vitalos.co.uk
# Sender address for notifications and sign-in mail (an address on a Resend-verified domain; address only).
NOTIFY_FROM=notifications@vitalos.co.uk
# Who receives owner notifications. Defaults to PRIMARY_OWNER_EMAIL, then admin@vitalos.co.uk.
NOTIFY_OWNER_EMAIL=admin@vitalos.co.uk
# log (default: writes messages to the log, sends nothing) or resend (live sending).
EMAIL_TRANSPORT=log
# Resend restricted "Sending access" key. Secret.
RESEND_API_KEY=__SET_IN_SECRET_MANAGER__
# Signing secret (whsec_...) for POST /api/webhooks/resend delivery events. Secret.
RESEND_WEBHOOK_SECRET=__SET_IN_SECRET_MANAGER__
# Sends the app will make per day before it holds the rest back (Resend free tier: 100 a day; recheck).
RESEND_DAILY_LIMIT=100
# Where inbound mail comes from: cloudflare (Email Worker, primary), resend (Resend Inbound fallback) or graph (later).
INBOUND_PROVIDER=cloudflare
# Shared HMAC secret for POST /api/inbound/email (the Worker) and /api/inbound/web-form (the website). Secret.
# Generate: openssl rand -hex 32. The Worker holds the same value as a wrangler secret.
INBOUND_WEBHOOK_SECRET=__SET_IN_SECRET_MANAGER__
# Cloudflare Turnstile secret for the website form's token (optional). Secret.
TURNSTILE_SECRET_KEY=__SET_IN_SECRET_MANAGER__

# --- Vitalos Relay (website chat hand-off, docs/relay/API.md, ADR-035) ---------------------------
# Website base URL serving the signed admin API (/api/relay/admin/*), e.g. https://www.vitalos.co.uk.
# Empty (default) hides the Relay tab and makes POST /api/inbound/relay answer 404.
RELAY_API_BASE_URL=
# HMAC secret for requests to the website's admin API (32+ random bytes; the website holds the same value). Secret.
# Generate: openssl rand -hex 32
RELAY_ADMIN_API_SECRET=__SET_IN_SECRET_MANAGER__
# HMAC secret for the website's alert webhook to POST /api/inbound/relay (same value on the website). Secret.
RELAY_WEBHOOK_SECRET=__SET_IN_SECRET_MANAGER__
# Open the Supabase Realtime socket on Relay pages (pings only; polling every 10 s is the fallback).
RELAY_REALTIME_ENABLED=True
# http (default, talks to the website) or fake (in-memory sample data for local UI work; refused in prod).
RELAY_CLIENT=http
# From header of Relay alert emails (an address on a Resend-verified domain).
RELAY_EMAIL_FROM=Vitalos Relay <relay@notify.vitalos.co.uk>

# --- Attachment storage (optional; without it attachments are not stored) -----------------------
# S3-compatible, private bucket, e.g. Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
# R2 uses "auto".
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=__SET_IN_SECRET_MANAGER__
OBJECT_STORAGE_SECRET_ACCESS_KEY=__SET_IN_SECRET_MANAGER__

# --- Notifications and retention ----------------------------------------------------------------
# Optional Slack incoming webhook for enquiry alerts. Secret. Leave empty to disable.
SLACK_WEBHOOK_URL=
# `manage.py enforce_enquiry_retention` is a dry run unless this is true (24-month retention).
RETENTION_ENFORCE=false

# --- Logging and monitoring --------------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# json (one JSON object per line, with request IDs) or text (human-readable, dev default).
LOG_FORMAT=text
# Optional Sentry error reporting. Leave empty to disable.
SENTRY_DSN=
# Fraction of requests traced for performance monitoring when Sentry is enabled (0.0–1.0).
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Backups (bin/backup.sh: portable manual dump; production uses .github/workflows/backup.yml) ---
# Directory pg_dump writes to.
BACKUP_DIR=/backups
# Days of dumps to keep; older files are deleted after each successful dump.
BACKUP_RETENTION_DAYS=14

# --- Smoke test (e2e/smoke.py) -----------------------------------------------------------------
# Base URL to test, e.g. https://admin.vitalos.co.uk
SMOKE_BASE_URL=http://localhost:8000
# Account used by the smoke test (normally the bootstrap admin).
SMOKE_EMAIL=
# Its password (export it in the shell for the run; do not store it here).
SMOKE_PASSWORD=
# Base32 TOTP secret, only if the account already has an authenticator enrolled.
SMOKE_TOTP_SECRET=
# Optional path to a Chromium binary when Playwright's bundled browser is unavailable.
SMOKE_CHROMIUM=
