# Vitalos Super Admin configuration. Copy to .env for local development (never commit .env).
# In production every value is set as a platform secret / environment variable instead.

# --- Django core -------------------------------------------------------------------------------
# Settings module: config.settings.dev (local), config.settings.test (pytest), config.settings.prod (live).
DJANGO_SETTINGS_MODULE=config.settings.dev
# Required in prod, at least 50 random characters. Generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
# Leave empty locally: dev generates one into the ignored .dev_secret_key file.
DJANGO_SECRET_KEY=
# Dev only: set to False to preview production error pages locally.
DJANGO_DEBUG=True
# Shown as a banner outside production (development, staging, production).
APP_ENVIRONMENT=development
# Comma-separated host names the app answers to. Prod: admin.vitalos.co.uk
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated scheme+host origins allowed to POST. Prod: https://admin.vitalos.co.uk
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Database ----------------------------------------------------------------------------------
# Defaults to SQLite (db.sqlite3) when unset. Prod: Supabase session pooler (or Neon pooled) string, e.g.
# postgresql://postgres.<project-ref>:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
# Seconds to keep database connections open between requests. Prod defaults to 0 (pooled free-tier database).
DB_CONN_MAX_AGE=60
# Disable server-side cursors (required behind transaction pooling, e.g. Neon's PgBouncer). Prod default True.
DB_DISABLE_SERVER_SIDE_CURSORS=False

# --- HTTPS and proxies (prod) ------------------------------------------------------------------
# Redirect plain HTTP to HTTPS (the ingress terminates TLS and sets X-Forwarded-Proto).
SECURE_SSL_REDIRECT=True
# Strict-Transport-Security max-age in seconds (1 year).
SECURE_HSTS_SECONDS=31536000
# Reverse-proxy hops trusted for X-Forwarded-For (client IP for lockouts). Azure Container Apps: 1.
TRUSTED_PROXY_COUNT=0

# --- Bootstrap administrator -------------------------------------------------------------------
# Used by `manage.py create_superadmin` (release job). The password is only ever read from here.
BOOTSTRAP_ADMIN_EMAIL=superadmin-owner@example.invalid
# At least 12 characters. Generate a strong value and keep it in the secrets store, never in git.
BOOTSTRAP_ADMIN_PASSWORD=

# --- Authentication hardening ------------------------------------------------------------------
# Require TOTP for SuperAdmin accounts (keep True outside throwaway local databases).
OTP_REQUIRED_FOR_SUPERADMIN=True
# Failed sign-ins (per email + IP) before a temporary lockout, and the lockout length in minutes.
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=30

# --- Logging and monitoring --------------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# json (one JSON object per line, with request IDs) or text (human-readable, dev default).
LOG_FORMAT=text
# Optional Sentry error reporting. Leave empty to disable.
SENTRY_DSN=
# Fraction of requests traced for performance monitoring when Sentry is enabled (0.0–1.0).
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Backups (bin/backup.sh: portable manual dump; production uses .github/workflows/backup.yml) ---
# Directory pg_dump writes to.
BACKUP_DIR=/backups
# Days of dumps to keep; older files are deleted after each successful dump.
BACKUP_RETENTION_DAYS=14

# --- Smoke test (e2e/smoke.py) -----------------------------------------------------------------
# Base URL to test, e.g. https://admin.vitalos.co.uk
SMOKE_BASE_URL=http://localhost:8000
# Account used by the smoke test (normally the bootstrap admin).
SMOKE_EMAIL=
# Its password (export it in the shell for the run; do not store it here).
SMOKE_PASSWORD=
# Base32 TOTP secret, only if the account already has an authenticator enrolled.
SMOKE_TOTP_SECRET=
# Optional path to a Chromium binary when Playwright's bundled browser is unavailable.
SMOKE_CHROMIUM=
