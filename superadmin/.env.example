# Vitalos Super Admin configuration. Copy to .env for local development (never commit .env).
# In production every value is set as a platform secret / environment variable instead.

# --- Django core -------------------------------------------------------------------------------
# Settings module: config.settings.dev (local), config.settings.test (pytest), config.settings.prod (live).
DJANGO_SETTINGS_MODULE=config.settings.dev
# Required in prod, at least 50 random characters. Generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
# Leave empty locally: dev generates one into the ignored .dev_secret_key file.
DJANGO_SECRET_KEY=
# Dev only: set to False to preview production error pages locally.
DJANGO_DEBUG=True
# Shown as a banner outside production (development, staging, production). The app keeps this name;
# there is no APP_ENV.
APP_ENVIRONMENT=development
# Public base URL, used in emailed links. Prod: https://admin.vitalos.co.uk (the deploy always sets it).
APP_BASE_URL=http://localhost:8000
# Comma-separated host names the app answers to. Prod: admin.vitalos.co.uk
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated scheme+host origins allowed to POST. Prod: https://admin.vitalos.co.uk
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Database ----------------------------------------------------------------------------------
# Defaults to SQLite (db.sqlite3) when unset. Prod: Supabase session pooler (or Neon pooled) string, e.g.
# postgresql://postgres.<project-ref>:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
# Seconds to keep database connections open between requests. Prod defaults to 0 (pooled free-tier database).
DB_CONN_MAX_AGE=60
# Disable server-side cursors (required behind transaction pooling, e.g. Neon's PgBouncer). Prod default True.
DB_DISABLE_SERVER_SIDE_CURSORS=False

# --- HTTPS and proxies (prod) ------------------------------------------------------------------
# Redirect plain HTTP to HTTPS (the ingress terminates TLS and sets X-Forwarded-Proto).
SECURE_SSL_REDIRECT=True
# Strict-Transport-Security max-age in seconds (1 year).
SECURE_HSTS_SECONDS=31536000
# Reverse-proxy hops trusted for X-Forwarded-For (client IP for lockouts). Azure Container Apps: 1.
TRUSTED_PROXY_COUNT=0

# --- Bootstrap administrator -------------------------------------------------------------------
# Used by `manage.py create_superadmin` (release job). The password is only ever read from here.
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
# At least 12 characters. Generate a strong value and keep it in the secrets store, never in git.
BOOTSTRAP_ADMIN_PASSWORD=

# --- Authentication hardening ------------------------------------------------------------------
# Require TOTP for SuperAdmin accounts (keep True outside throwaway local databases).
# REQUIRE_MFA_FOR_SUPER_ADMIN is accepted as an alias.
OTP_REQUIRED_FOR_SUPERADMIN=True
# The single primary owner. `manage.py create_owner` (run by the release job) creates this account with
# no password; `manage.py issue_setup_link --email <it>` prints a one-time 30-minute set-password link.
# Only the owner grants or revokes SuperAdmin. There is no SUPER_ADMIN_EMAILS list. Empty = no owner.
PRIMARY_OWNER_EMAIL=
# Pre-fill the sign-in email field. Empty (default) because pre-filling a public page reveals the login.
DEFAULT_SIGNIN_EMAIL=
# Offer "Forgot password". Leave empty for the default: on only when mail can be delivered.
PASSWORD_RESET_ENABLED=
# Failed sign-ins (per email + IP) before a temporary lockout, and the lockout length in minutes.
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=30

# --- Email: outbound, inbound and notifications (docs/email-setup.md) --------------------------
# Address enquiry replies are sent from and the inbound Worker is bound to.
SUPPORT_MAILBOX=support@vitalos.co.uk
# Sender address for notifications and sign-in mail (an address on a Resend-verified domain; address only).
NOTIFY_FROM=notifications@vitalos.co.uk
# Who receives owner notifications. Defaults to PRIMARY_OWNER_EMAIL, then admin@vitalos.co.uk.
NOTIFY_OWNER_EMAIL=admin@vitalos.co.uk
# log (default: writes messages to the log, sends nothing) or resend (live sending).
EMAIL_TRANSPORT=log
# Resend restricted "Sending access" key. Secret.
RESEND_API_KEY=__SET_IN_SECRET_MANAGER__
# Signing secret (whsec_...) for POST /api/webhooks/resend delivery events. Secret.
RESEND_WEBHOOK_SECRET=__SET_IN_SECRET_MANAGER__
# Sends the app will make per day before it holds the rest back (Resend free tier: 100 a day; recheck).
RESEND_DAILY_LIMIT=100
# Outreach mailbox (docs/email-setup.md, step 13; ADR-051). Cold outreach is not allowed on Resend, so
# outreach templates send only through this mailbox. Empty: outreach sends are refused while
# EMAIL_TRANSPORT=resend. OUTREACH_MAILBOX is the From and Reply-To address.
OUTREACH_MAILBOX=
# Microsoft 365 over Microsoft Graph (preferred): an Entra app with Mail.Send, scoped to the mailbox.
OUTREACH_GRAPH_TENANT_ID=
OUTREACH_GRAPH_CLIENT_ID=
# Client secret of that Entra app. Secret.
OUTREACH_GRAPH_CLIENT_SECRET=__SET_IN_SECRET_MANAGER__
# Or any mailbox over SMTP (implicit TLS on 465, STARTTLS on 587). Microsoft is retiring password SMTP.
OUTREACH_SMTP_HOST=
OUTREACH_SMTP_PORT=465
OUTREACH_SMTP_USER=
# Password or app password for that mailbox. Secret.
OUTREACH_SMTP_PASSWORD=__SET_IN_SECRET_MANAGER__
# Where inbound mail comes from: cloudflare (Email Worker, primary), resend (Resend Inbound fallback) or graph (later).
INBOUND_PROVIDER=cloudflare
# Shared HMAC secret for POST /api/inbound/email (the Worker) and /api/inbound/web-form (the website). Secret.
# Generate: openssl rand -hex 32. The Worker holds the same value as a wrangler secret.
INBOUND_WEBHOOK_SECRET=__SET_IN_SECRET_MANAGER__
# Cloudflare Turnstile secret for the website form's token (optional). Secret.
TURNSTILE_SECRET_KEY=__SET_IN_SECRET_MANAGER__

# --- Vitalos Relay (website chat hand-off, docs/relay/API.md, ADR-035) ---------------------------
# Website base URL serving the signed admin API (/api/relay/admin/*), e.g. https://www.vitalos.co.uk.
# Empty (default) hides the Relay tab and makes POST /api/inbound/relay answer 404.
RELAY_API_BASE_URL=
# HMAC secret for requests to the website's admin API (32+ random bytes; the website holds the same value). Secret.
# Generate: openssl rand -hex 32
RELAY_ADMIN_API_SECRET=__SET_IN_SECRET_MANAGER__
# HMAC secret for the website's alert webhook to POST /api/inbound/relay (same value on the website). Secret.
RELAY_WEBHOOK_SECRET=__SET_IN_SECRET_MANAGER__
# Open the Supabase Realtime socket on Relay pages (pings only; polling every 10 s is the fallback).
RELAY_REALTIME_ENABLED=True
# http (default, talks to the website) or fake (in-memory sample data for local UI work; refused in prod).
RELAY_CLIENT=http
# From header of Relay alert emails (an address on a Resend-verified domain).
RELAY_EMAIL_FROM=Vitalos Relay <relay@notify.vitalos.co.uk>

# --- Product Pipeline (ADR-044) -----------------------------------------------------------------
# Askbridge status endpoint, called server-side only with a Bearer token (3 s timeout, cached 60 s).
# Production requires https.
ASKBRIDGE_STATUS_URL=https://askbridge.vitalos.co.uk/api/platform/v1/status
# Bearer token the Askbridge status endpoint accepts. Secret. Empty (default) shows "Status not configured"
# and makes no request. Generate: openssl rand -hex 32 (Askbridge holds the same value).
ASKBRIDGE_STATUS_TOKEN=
# Where "Open Askbridge Superadmin" goes after the permission check and audit (nothing is appended).
ASKBRIDGE_SUPERADMIN_URL=https://askbridge.vitalos.co.uk/superadmin
# Answerd, Vitalos Workforce and TipSignal: same three settings each. No status endpoint exists yet, so the
# URLs and tokens stay empty ("Status not configured", no request). An empty superadmin URL hides Open.
ANSWERD_STATUS_URL=
ANSWERD_STATUS_TOKEN=
# The clickable prototype's admin console (demo data) until Answerd has its own superadmin.
ANSWERD_SUPERADMIN_URL=https://answerd-demo.vitalos.co.uk/admin
WORKFORCE_STATUS_URL=
WORKFORCE_STATUS_TOKEN=
WORKFORCE_SUPERADMIN_URL=
TIPSIGNAL_STATUS_URL=
TIPSIGNAL_STATUS_TOKEN=
# The TipSignal admin is Tailscale-only today; set an https address if one is published.
TIPSIGNAL_SUPERADMIN_URL=
# Pitline (formerly Autofix; the setting names keep AUTOFIX_) serves the contract from its own superadmin.
# Production requires https.
AUTOFIX_STATUS_URL=https://pitline.co.uk/superadmin/api/platform/v1/status
# Secret. Pitline holds the same value (Container Apps secret autofix-status-token on autofix-superadmin).
AUTOFIX_STATUS_TOKEN=
AUTOFIX_SUPERADMIN_URL=https://pitline.co.uk/superadmin/

# --- Attachment storage (optional; without it attachments are not stored) -----------------------
# S3-compatible, private bucket, e.g. Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
# R2 uses "auto".
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=__SET_IN_SECRET_MANAGER__
OBJECT_STORAGE_SECRET_ACCESS_KEY=__SET_IN_SECRET_MANAGER__

# --- Insights and Careers (docs/content/BRIEF.md section 10, ADR-039 to ADR-042) ------------------
# Comma-separated website base URLs that receive signed revalidation events. The FIRST is the public
# site used for Preview and "View on site" links, e.g. https://vitalos.co.uk (the canonical host; www answers 308)
CONTENT_WEB_TARGETS=
# Signing keys: comma-separated "keyId:secret" entries. The signer uses the first entry and the verifier
# accepts any entry, so a key rotates with no downtime. Key ids match [a-z0-9-]{1,32}. Secrets.
# Generate a secret: python -c "import secrets;print(secrets.token_hex(32))"
# Accepted keys for the read API (/api/content/v1/..., also the tick).
CONTENT_READ_CLIENT_KEYS=
# Accepted keys for CV upload tickets and applications from the website.
CAREERS_SUBMIT_CLIENT_KEYS=
# Signs revalidation calls to {target}/api/content/revalidate.
CONTENT_REVALIDATE_SECRET=
# Signs render calls to {first target}/api/content/render (editor preview).
CONTENT_RENDER_SECRET=
# Signs and verifies preview tokens.
CONTENT_PREVIEW_SECRET=
# Post and author images: public-read bucket on the OBJECT_STORAGE_* endpoint, and its public base URL
# (CDN or bucket public host). Without a bucket, images are kept only in development.
CONTENT_MEDIA_BUCKET=
CONTENT_MEDIA_PUBLIC_BASE_URL=
# CVs: private bucket on the same endpoint. Without it production refuses CV upload tickets (ADR-041).
CAREERS_CV_BUCKET=
CAREERS_CV_MAX_MB=10
# Sender for careers alerts; empty uses NOTIFY_FROM.
CAREERS_EMAIL_FROM=
# Receipts and outcome emails to candidates. Off until the owner approves (brief 0.2).
CAREERS_CANDIDATE_EMAILS_ENABLED=false
# Relay knowledge-base hook (Relay is not built yet).
CONTENT_RELAY_SYNC_ENABLED=false
# Salt for hashing applicant IP addresses. Secret.
CONTENT_IP_SALT=
# Read API requests per minute per key id.
CONTENT_READ_RATE_LIMIT=600
# Run the content tick opportunistically (at most once a minute) on content requests (ADR-042).
CONTENT_OPPORTUNISTIC_TICK=true

# --- Notifications and retention ----------------------------------------------------------------
# Optional Slack incoming webhook for enquiry alerts. Secret. Leave empty to disable.
SLACK_WEBHOOK_URL=
# `manage.py enforce_enquiry_retention` is a dry run unless this is true (24-month retention).
RETENTION_ENFORCE=false

# --- Logging and monitoring --------------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# json (one JSON object per line, with request IDs) or text (human-readable, dev default).
LOG_FORMAT=text
# Optional Sentry error reporting. Leave empty to disable.
SENTRY_DSN=
# Fraction of requests traced for performance monitoring when Sentry is enabled (0.0–1.0).
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Vitalos AI & Data model provider (apps.aicore; docs/ai-data/engineering/ai-core.md) -------
# anthropic (default: Claude through the official SDK) or openai-compatible (chat completions).
AI_DATA_LLM_PROVIDER=anthropic
# Model name. anthropic defaults to claude-sonnet-5-5. Price estimates: apps/aicore/core/pricing_table.json
AI_DATA_LLM_MODEL=
# anthropic only: how much the model thinks (low, medium, high, xhigh, max). Extraction runs at low.
AI_DATA_LLM_EFFORT=low
# openai-compatible only: chat completions base URL (https), e.g. https://api.openai.com/v1
AI_DATA_LLM_BASE_URL=
# API key. Secret. In production the deploy passes AI_DATA_LLM_API_KEY, or the organisation's
# ANTHROPIC_API_KEY when that is unset (owner instruction, AID-017). Empty = live model path unavailable.
AI_DATA_LLM_API_KEY=
# Environment kill switch: true blocks every demonstrator run and model call, whatever the database says.
AI_DATA_DISABLED=false
# Local development only: answer AI & Data workspace actions with a labelled test double (ignored unless DEBUG).
AI_DATA_SIMULATED_PROVIDER=false
# Share of the daily run cap (percent, rounded down) that public and customer workflows may use, so staff
# workflows keep headroom: website brief assist (aidata.brief_*) and the portal assistant (portal.*).
AI_DATA_BRIEF_ASSIST_DAILY_SHARE_PERCENT=30
AI_DATA_PORTAL_DAILY_SHARE_PERCENT=30
# Portal assistant answers one member may request per hour before they get the compiled (non-AI) answer.
PORTAL_AI_PER_MEMBER_PER_HOUR=10

# --- Billing (apps.billing; apps/billing/README.md) --------------------------------------------
# Vitalos's own Stripe restricted key (never another product's). Secret. Empty = Stripe calls off.
BILLING_STRIPE_SECRET_KEY=
# Signing secret of the Stripe webhook endpoint /api/webhooks/stripe/. Secret. Empty = endpoint answers 503.
BILLING_STRIPE_WEBHOOK_SECRET=
# Public site hosting /pay and /pay/thank-you (https in production).
BILLING_PUBLIC_SITE_URL=https://vitalos.co.uk

# --- Client portal (apps.portal; docs/adr/ADR-056-client-portal.md) ---------------------------
# Host that serves ONLY the customer portal (no Super Admin URLs). Production defaults to
# portal.vitalos.co.uk (owner decision); the custom-domain binding and DNS are a separate owner step and
# the portal answers 404 on that host until the domain resolves. Empty (local default) mounts the portal at
# /portal/ for local preview only.
PORTAL_HOST=
# Master switch for customer access. Local default on; production defaults on only when PORTAL_HOST is set.
# Staff tools and "Preview as customer" work whatever this is.
PORTAL_ENABLED=true
# Invitation links work once and expire after this many hours.
PORTAL_INVITE_TTL_HOURS=72
# A manually reported managed-service status older than this is labelled stale.
PORTAL_STATUS_STALE_HOURS=72
# Private S3-compatible bucket for portal files (same OBJECT_STORAGE_* credentials). Empty: production keeps no
# file bytes and says so to the customer; development keeps them on local disk.
PORTAL_FILES_BUCKET=
# Local demonstrations only: replay hand-written, labelled assistant answers. Forced off in production.
PORTAL_AI_REPLAY=false

# --- Backups (bin/backup.sh: portable manual dump; production uses .github/workflows/backup.yml) ---
# Directory pg_dump writes to.
BACKUP_DIR=/backups
# Days of dumps to keep; older files are deleted after each successful dump.
BACKUP_RETENTION_DAYS=14

# --- Smoke test (e2e/smoke.py) -----------------------------------------------------------------
# Base URL to test, e.g. https://admin.vitalos.co.uk
SMOKE_BASE_URL=http://localhost:8000
# Account used by the smoke test (normally the bootstrap admin).
SMOKE_EMAIL=
# Its password (export it in the shell for the run; do not store it here).
SMOKE_PASSWORD=
# Base32 TOTP secret, only if the account already has an authenticator enrolled.
SMOKE_TOTP_SECRET=
# Optional path to a Chromium binary when Playwright's bundled browser is unavailable.
SMOKE_CHROMIUM=
